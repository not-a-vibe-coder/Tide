# Telegram — create a bot with @BotFather and paste its token
TELEGRAM_BOT_TOKEN=

# Telegram user IDs allowed to run admin commands like /rebuild (comma-separated)
ADMIN_TELEGRAM_IDS=

# Walrus Memory (Mainnet) — from https://memory.walrus.xyz/dashboard
# Delegate private key (hex or suiprivkey1...). The matching public key is your MEMWAL_AGENT_ID.
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
# Set to true to log memory writes instead of sending them (local dev without keys)
MEMWAL_DRY_RUN=false

# Tatum — API key from https://dashboard.tatum.io/
TATUM_API_KEY=
TATUM_SUI_GRPC_URL=https://sui-mainnet-grpc.gateway.tatum.io
# Used automatically if gRPC fails (also Tatum)
TATUM_SUI_RPC_URL=https://sui-mainnet.gateway.tatum.io

# Market data (free, no key)
GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2

# Storage for the local cache (rebuilt from Walrus Memory with /rebuild)
DATABASE_PATH=./data/tide.db

# Scanner tuning
SCAN_INTERVAL_MINUTES=5
WALLET_CHECK_INTERVAL_MINUTES=30
MIN_LIQUIDITY_USD=10000
MIN_HOURLY_VOLUME_USD=5000
DIGEST_HOUR_LAGOS=9
